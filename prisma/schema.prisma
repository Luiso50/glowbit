generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BidStatus {
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
  FAILED
}

model Brand {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  storeUrl       String
  videoUrl       String?
  contactEmail   String
  logoUrl        String?
  description    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bids           Bid[]
  leaderboardRow LeaderboardEntry?
  milestones     MilestoneClaim[]
}

model Bid {
  id                      String    @id @default(cuid())
  brandId                 String
  amountCents             Int
  currency                String    @default("usd")
  status                  BidStatus @default(PENDING)
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  createdAt               DateTime  @default(now())
  paidAt                  DateTime?
  brand                   Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  leaderboardEntry        LeaderboardEntry?
  milestoneClaims         MilestoneClaim[]

  @@index([status, amountCents])
  @@index([brandId, createdAt])
}

model LeaderboardState {
  id        Int      @id
  updatedAt DateTime @updatedAt
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  rank      Int      @unique
  brandId   String   @unique
  bidId     String   @unique
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  bid       Bid      @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([rank])
}

model Milestone {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  description String?
  createdAt   DateTime         @default(now())
  claims      MilestoneClaim[]
}

model MilestoneClaim {
  id          String    @id @default(cuid())
  milestoneId String
  brandId     String
  bidId       String
  claimedAt   DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  bid         Bid       @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@unique([milestoneId, brandId])
  @@unique([milestoneId, bidId])
}